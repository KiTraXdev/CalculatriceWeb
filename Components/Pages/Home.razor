@page "/"
@rendermode InteractiveServer

<PageTitle>Ma Calculatrice</PageTitle>

<h1>Ma Calculatrice</h1>

<div class="modes">
    <button class="@(mode == "standard" ? "mode-actif" : "")"
            @onclick='() => ChangerMode("standard")'>
        Standard
    </button>

    <button class="@(mode == "scientifique" ? "mode-actif" : "")"
            @onclick='() => ChangerMode("scientifique")'>
        Scientifique
    </button>

    <button class="@(mode == "equations" ? "mode-actif" : "")"
            @onclick='() => ChangerMode("equations")'>
        Équations
    </button>
</div>

<div class="calculatrice">
<div class="indicateur-angle">
    @if (mode == "scientifique")
    {
        <span>Angle : @modeAngle</span>
    }
    else
    {
        <span>Angle : —</span>
    }
</div>

    <input value="@affichage" readonly />

    @if (mode == "scientifique")
    {
       <div class="touches-scientifiques">

    <!-- ANGLES / CONSTANTES -->
    <button @onclick='() => modeAngle = "DEG"'>DEG</button>
    <button @onclick='() => modeAngle = "RAD"'>RAD</button>
    <button @onclick="Pi">π</button>
    <button @onclick="Euler">e</button>

    <!-- TRIGONOMÉTRIE DIRECTE -->
    <button @onclick="Sinus">sin</button>
    <button @onclick="Cosinus">cos</button>
    <button @onclick="Tangente">tan</button>
    <button @onclick="ArcSinus">sin⁻¹</button>

    <button @onclick="ArcCosinus">cos⁻¹</button>
    <button @onclick="ArcTangente">tan⁻¹</button>

    <!-- PUISSANCES / RACINES -->
    <button @onclick="Carre">x²</button>
    <button @onclick="Cube">x³</button>
    <button @onclick="Puissance">xʸ</button>
    <button @onclick="RacineCarree">√</button>

    <button @onclick="RacineCubique">∛x</button>
    <button @onclick="Inverse">1/x</button>

    <!-- LOG / EXP -->
    <button @onclick="Logarithme">log</button>
    <button @onclick="LogarithmeNaturel">ln</button>
    <button @onclick="Puissance10">10ˣ</button>
    <button @onclick="Exponentielle">eˣ</button>

    <!-- AUTRES -->
    <button @onclick="ValeurAbsolue">|x|</button>
    <button @onclick="Factorielle">x!</button>
    <button @onclick="ChangerSigne">±</button>
    <button @onclick="Virgule">,</button>

    <button @onclick="Pourcentage">%</button>

    <!-- PARENTHÈSES -->
    <button @onclick='() => AjouterExpression("(")'>(</button>
    <button @onclick='() => AjouterExpression(")")'>)</button>

    <!-- EXPRESSIONS SCIENTIFIQUES -->
    <button @onclick='() => AjouterExpression("sqrt(")'>√(</button>
    <button @onclick='() => AjouterExpression("cbrt(")'>∛(</button>

    <button @onclick='() => AjouterExpression("sin(")'>sin(</button>
    <button @onclick='() => AjouterExpression("cos(")'>cos(</button>
    <button @onclick='() => AjouterExpression("tan(")'>tan(</button>

    <button @onclick='() => AjouterExpression("asin(")'>sin⁻¹(</button>
    <button @onclick='() => AjouterExpression("acos(")'>cos⁻¹(</button>
    <button @onclick='() => AjouterExpression("atan(")'>tan⁻¹(</button>

    <button @onclick='() => AjouterExpression("log(")'>log(</button>
    <button @onclick='() => AjouterExpression("ln(")'>ln(</button>

    <button @onclick='() => AjouterExpression("pow10(")'>10ˣ(</button>
    <button @onclick='() => AjouterExpression("exp(")'>eˣ(</button>

    <button @onclick='() => AjouterExpression("inv(")'>1/x(</button>
    <button @onclick='() => AjouterExpression("abs(")'>|x|(</button>
    <button @onclick='() => AjouterExpression("fact(")'>x!(</button>
    <button @onclick='() => AjouterExpression("pct(")'>%(</button>

</div>
    }

   @if (mode == "equations")
{
   <div class="touches-equations">

    <!-- INCONNUES -->
    <button @onclick='() => AjouterExpression("x")'>x</button>
    <button @onclick='() => AjouterExpression("x²")'>x²</button>
    <button @onclick='() => AjouterExpression("y")'>y</button>

    <!-- COEFFICIENTS -->
    <button @onclick='() => AjouterExpression("a")'>a</button>
    <button @onclick='() => AjouterExpression("b")'>b</button>
    <button @onclick='() => AjouterExpression("c")'>c</button>

    <!-- PARENTHÈSES -->
    <button @onclick='() => AjouterExpression("(")'>(</button>
    <button @onclick='() => AjouterExpression(")")'>)</button>

    <!-- ÉGALITÉ -->
    <button class="egal-equation"
            @onclick='() => AjouterExpression("=")'>
        =
    </button>

</div>
}

    <div class="touches">

        <div></div>
        <div></div>
        <div></div>
        <button class="effacer" @onclick="Retour">⌫</button>

        <button @onclick='() => Chiffre("7")'>7</button>
        <button @onclick='() => Chiffre("8")'>8</button>
        <button @onclick='() => Chiffre("9")'>9</button>
        <button class="operation" @onclick='() => ChoisirOperation("/")'>÷</button>

        <button @onclick='() => Chiffre("4")'>4</button>
        <button @onclick='() => Chiffre("5")'>5</button>
        <button @onclick='() => Chiffre("6")'>6</button>
        <button class="operation" @onclick='() => ChoisirOperation("*")'>×</button>

        <button @onclick='() => Chiffre("1")'>1</button>
        <button @onclick='() => Chiffre("2")'>2</button>
        <button @onclick='() => Chiffre("3")'>3</button>
        <button class="operation" @onclick='() => ChoisirOperation("-")'>−</button>

        <button class="effacer" @onclick="Effacer">C</button>
        <button @onclick='() => Chiffre("0")'>0</button>
        <button class="egal" @onclick="Egal">=</button>
        <button class="operation" @onclick='() => ChoisirOperation("+")'>+</button>

    </div>
</div>

<p class="credit">Développé par Kitrax</p>

<style>
.modes button {
    padding: 10px 16px;
    font-size: 16px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: #444;
    color: white;
}

.modes .mode-actif {
    background: #ff9500;
    font-weight: bold;
}
    .modes {
