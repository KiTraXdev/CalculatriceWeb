@page "/"
@rendermode InteractiveServer

<PageTitle>KITRAX Web Tester</PageTitle>

<div class="page-tester">

    <h1>KITRAX Web Tester</h1>

    <p class="sous-titre">
        Crée, modifie et exécute tes tests web.
    </p>

    <div class="bloc">

        <label>🌐 URL du site à tester</label>

        <input
            @bind="url"
            placeholder="https://exemple.com" />

    </div>

    <div class="bloc">

        <label>📝 Consigne du test</label>

        <textarea
            @bind="consigne"
            placeholder="Exemple : clique sur 1, puis +, puis 1, puis = et vérifie que le résultat vaut 2">
        </textarea>

    </div>

    <button class="bouton-generer">
        ⚙️ Traduire en code
    </button>

    <div class="bloc">

        <label>💻 Code du test</label>

        <textarea
            class="editeur-code"
            placeholder="// Le code généré apparaîtra ici...">
        </textarea>

    </div>

    <button class="bouton-executer">
        ▶ Exécuter le test
    </button>

    <div class="bloc">

        <label>📟 Console</label>

        <div class="console">
            KITRAX Web Tester prêt.
        </div>

    </div>

</div>

@code
{
    string url = "";
    string consigne = "";
}