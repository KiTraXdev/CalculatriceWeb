(double a, double b, double c) AnalyserCoteSecondDegre(string cote)
{
    cote = cote.Replace(" ", "").Replace("-", "+-");

    string[] termes = cote.Split(
        '+',
        StringSplitOptions.RemoveEmptyEntries
    );

    double a = 0;
    double b = 0;
    double c = 0;

    foreach (string terme in termes)
    {
        if (terme.Contains("x²"))
        {
            string texte = terme.Replace("x²", "");

            if (texte == "")
                a += 1;
            else if (texte == "-")
                a -= 1;
            else
                a += double.Parse(texte);
        }
        else if (terme.Contains("x"))
        {
            string texte = terme.Replace("x", "");

            if (texte == "")
                b += 1;
            else if (texte == "-")
                b -= 1;
            else
                b += double.Parse(texte);
        }
        else
        {
            c += double.Parse(terme);
        }
    }

    return (a, b, c);
}
void ResoudreSecondDegre()
{
    try
    {
        string eq = expression
            .Replace(" ", "")
            .Replace("−", "-");

        string[] parties = eq.Split('=');

        if (parties.Length != 2)
        {
            affichage = "Équation invalide";
            return;
        }

        // Analyse séparément les deux côtés
        var gauche = AnalyserCoteSecondDegre(parties[0]);
        var droite = AnalyserCoteSecondDegre(parties[1]);

        // On ramène mathématiquement tout du même côté
        double a = gauche.a - droite.a;
        double b = gauche.b - droite.b;
        double c = gauche.c - droite.c;

        // Si x² disparaît, l'équation devient du premier degré
        if (a == 0)
        {
            if (b == 0)
            {
                if (c == 0)
                    affichage = "Infinité de solutions";
                else
                    affichage = "Aucune solution";

                return;
            }

            double xPremierDegre = -c / b;

            affichage =
                "x = " + Math.Round(xPremierDegre, 10);

            expression = "";
            return;
        }

        double delta = (b * b) - (4 * a * c);

        if (delta > 0)
        {
            double x1 =
                (-b - Math.Sqrt(delta)) / (2 * a);

            double x2 =
                (-b + Math.Sqrt(delta)) / (2 * a);

            affichage =
                "Δ = " + Math.Round(delta, 10)
                + " | x1 = " + Math.Round(x1, 10)
                + " | x2 = " + Math.Round(x2, 10);
        }
        else if (delta == 0)
        {
            double x = -b / (2 * a);

            affichage =
                "Δ = 0 | x = " + Math.Round(x, 10);
        }
        else
        {
            affichage =
                "Δ = " + Math.Round(delta, 10)
                + " | Aucune solution réelle";
        }

        expression = "";
    }
    catch
    {
        affichage = "Équation invalide";
    }
}
void Egal()
{
    if (mode == "equations" && expression.Contains("="))
    {
        if (expression.Contains("x²"))
        {
            ResoudreSecondDegre();
        }
        else
        {
            ResoudreEquation();
        }

        return;
    }

    CalculerExpression();

    if (affichage != "Erreur")
    {
        expression = affichage;
    }
}
void ResoudreEquation()
{
    try
    {
        string eq = expression.Replace(" ", "");

        if (!eq.Contains("=") || !eq.Contains("x"))
        {
            affichage = "Équation invalide";
            return;
        }

        string[] parties = eq.Split('=');

        if (parties.Length != 2)
        {
            affichage = "Équation invalide";
            return;
        }

        (double coeffGauche, double constanteGauche) = AnalyserCote(parties[0]);
        (double coeffDroite, double constanteDroite) = AnalyserCote(parties[1]);

        double coeffFinal = coeffGauche - coeffDroite;
        double constanteFinale = constanteDroite - constanteGauche;

        if (coeffFinal == 0)
        {
            if (constanteFinale == 0)
                affichage = "Infinité de solutions";
            else
                affichage = "Aucune solution";

            return;
        }

        double x = constanteFinale / coeffFinal;

        affichage = "x = " + Math.Round(x, 10);
        expression = "";
    }
    catch
    {
        affichage = "Équation invalide";
    }
}
(double coefficient, double constante) AnalyserCote(string cote)
{
    cote = cote.Replace("-", "+-");

    string[] termes = cote.Split(
        '+',
        StringSplitOptions.RemoveEmptyEntries
    );

    double coefficient = 0;
    double constante = 0;

    foreach (string terme in termes)
    {
        if (terme.Contains("x"))
        {
            string coeffTexte = terme.Replace("x", "");

            if (coeffTexte == "")
                coefficient += 1;
            else if (coeffTexte == "-")
                coefficient -= 1;
            else
                coefficient += double.Parse(coeffTexte);
        }
        else
        {
            constante += double.Parse(terme);
        }
    }

    return (coefficient, constante);
}

