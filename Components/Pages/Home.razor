</style>

@code {
    string affichage = "0";
    double premierNombre = 0;
    string operation = "";
    bool nouveauNombre = false;
    string deuxiemeNombreTexte = "";

    string mode = "standard";
string expression = "";
    void ChangerMode(string nouveauMode)
{
    mode = nouveauMode;
}
  
void Chiffre(string chiffre)
{
    if (affichage == "Erreur")
    {
        affichage = "0";
        expression = "";
    }

    if (expression == "" && affichage != "0")
    {
        expression = affichage;
    }

    expression += chiffre;
    affichage = expression;
}

    void ChoisirOperation(string op)
{
    if (affichage == "Erreur")
    {
        affichage = "0";
        expression = "";
    }

    if (expression == "")
    {
        expression = affichage;
    }

    string symbole = op;

    if (op == "*")
        symbole = "×";

    if (op == "/")
        symbole = "÷";

    expression += " " + symbole + " ";
    affichage = expression;
}

    void Calculer()
    {
        if (operation == "")
        {
            return;
        }

        if (!double.TryParse(deuxiemeNombreTexte, out double deuxiemeNombre))
        {
            return;
        }

        double resultat = 0;

        if (operation == "+")
        {
            resultat = premierNombre + deuxiemeNombre;
        }
        else if (operation == "-")
        {
            resultat = premierNombre - deuxiemeNombre;
        }
        else if (operation == "*")
        {
            resultat = premierNombre * deuxiemeNombre;
        }
        else if (operation == "^")
{
    resultat = Math.Pow(premierNombre, deuxiemeNombre);
}
        else if (operation == "/")
        {
            if (deuxiemeNombre == 0)
            {
                affichage = "Erreur";
                operation = "";
                deuxiemeNombreTexte = "";
                nouveauNombre = true;
                return;
            }

            resultat = premierNombre / deuxiemeNombre;
        }

        affichage = resultat.ToString();

        premierNombre = resultat;
        operation = "";
        deuxiemeNombreTexte = "";
        nouveauNombre = true;
    }

    void Effacer()
    {
        affichage = "0";
        premierNombre = 0;
        operation = "";
        deuxiemeNombreTexte = "";
        nouveauNombre = false;
        expression = "";
    }

   void Retour()
{
    if (mode == "scientifique" || mode == "equations")
    {
        if (expression.Length > 0)
        {
            expression = expression.Substring(0, expression.Length - 1);
        }

        affichage = expression == "" ? "0" : expression;
        return;
    }

    if (affichage == "Erreur")
    {
        affichage = "0";
        return;
    }

    if (affichage.Length > 1)
    {
        affichage = affichage.Substring(0, affichage.Length - 1);
    }
    else
    {
        affichage = "0";
    }
}
    
void Carre()
{
    if (!double.TryParse(affichage, out double nombre))
    {
        return;
    }

    double resultat = nombre * nombre;

    affichage = resultat.ToString();
    expression = affichage;
    nouveauNombre = true;
}
void Cube()
{
    if (!double.TryParse(affichage, out double nombre))
    {
        return;
    }

    double resultat = nombre * nombre * nombre;

    affichage = resultat.ToString();
    nouveauNombre = true;
}
void Puissance()
{
    if (expression == "")
    {
        expression = affichage;
    }

    expression += " ^ ";
    affichage = expression;
}
void Pi()
{
    if (expression == "" || affichage == "0")
    {
        expression = Math.PI.ToString();
    }
    else
    {
        expression += Math.PI.ToString();
    }

    affichage = expression;
}

void Euler()
{
    if (expression == "" || affichage == "0")
    {
        expression = Math.E.ToString();
    }
    else
    {
        expression += Math.E.ToString();
    }

    affichage = expression;
}
string modeAngle = "DEG";

double ConvertirAngle(double nombre)
{
    if (modeAngle == "DEG")
    {
        return nombre * Math.PI / 180;
    }

    return nombre;
    
}
double ConvertirResultatAngle(double radians)
{
    if (modeAngle == "DEG")
    {
        return radians * 180 / Math.PI;
    }

    return radians;
}

void RacineCarree()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    if (nombre < 0)
    {
        affichage = "Erreur";
        return;
    }

    affichage = Math.Round(Math.Sqrt(nombre), 10).ToString();
    expression = affichage;
}

void Sinus()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    double angle = ConvertirAngle(nombre);

    affichage = Math.Round(Math.Sin(angle), 10).ToString();
    expression = affichage;

}

void Cosinus()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    double angle = ConvertirAngle(nombre);

    affichage = Math.Round(Math.Cos(angle), 10).ToString();
    expression = affichage;
}

void Tangente()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    double angle = ConvertirAngle(nombre);

    affichage = Math.Round(Math.Tan(angle), 10).ToString();
    expression = affichage;
}

void ArcSinus()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    if (nombre < -1 || nombre > 1)
    {
        affichage = "Erreur";
        return;
    }

    double resultat = Math.Asin(nombre);
    resultat = ConvertirResultatAngle(resultat);

    affichage = Math.Round(resultat, 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}

void ArcCosinus()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    if (nombre < -1 || nombre > 1)
    {
        affichage = "Erreur";
        return;
    }

    double resultat = Math.Acos(nombre);
    resultat = ConvertirResultatAngle(resultat);

    affichage = Math.Round(resultat, 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}

void ArcTangente()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    double resultat = Math.Atan(nombre);
    resultat = ConvertirResultatAngle(resultat);

    affichage = Math.Round(resultat, 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}
void Logarithme()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    if (nombre <= 0)
    {
        affichage = "Erreur";
        return;
    }

    affichage = Math.Round(Math.Log10(nombre), 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}

void LogarithmeNaturel()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    if (nombre <= 0)
    {
        affichage = "Erreur";
        return;
    }

    affichage = Math.Round(Math.Log(nombre), 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}
void Puissance10()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    affichage = Math.Round(Math.Pow(10, nombre), 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}

void Exponentielle()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    affichage = Math.Round(Math.Exp(nombre), 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}
void Inverse()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    if (nombre == 0)
    {
        affichage = "Erreur";
        return;
    }

    affichage = Math.Round(1 / nombre, 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}

void ValeurAbsolue()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    affichage = Math.Abs(nombre).ToString();
    expression = affichage;
    nouveauNombre = true;
}

void RacineCubique()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    affichage = Math.Round(Math.Cbrt(nombre), 10).ToString();
    expression = affichage;
    nouveauNombre = true;
}

void Factorielle()
{
    if (!int.TryParse(affichage, out int nombre) || nombre < 0)
    {
        affichage = "Erreur";
        return;
    }

    if (nombre > 170)
    {
        affichage = "Erreur";
        return;
    }

    double resultat = 1;

    for (int i = 2; i <= nombre; i++)
    {
        resultat *= i;
    }

    affichage = resultat.ToString();
    expression = affichage;
    nouveauNombre = true;
}
void ChangerSigne()
{
    if (string.IsNullOrWhiteSpace(expression))
        return;

    int position = expression.Length - 1;

    // Cherche le début du dernier nombre
    while (position >= 0 &&
           (char.IsDigit(expression[position]) ||
            expression[position] == '.' ||
            expression[position] == ','))
    {
        position--;
    }

    int debutNombre = position + 1;

    if (debutNombre >= expression.Length)
        return;

    // Si le nombre possède déjà un "-" juste devant
    if (debutNombre > 0 && expression[debutNombre - 1] == '-')
    {
        expression = expression.Remove(debutNombre - 1, 1);
    }
    else
    {
        expression = expression.Insert(debutNombre, "-");
    }

    affichage = expression;
}
void Virgule()
{
    if (operation != "")
    {
        if (!deuxiemeNombreTexte.Contains(","))
        {
            if (deuxiemeNombreTexte == "")
                deuxiemeNombreTexte = "0,";

            else
                deuxiemeNombreTexte += ",";

            affichage = premierNombre
                + " "
                + operation
                + " "
                + deuxiemeNombreTexte;
        }
    }
    else
    {
        if (!affichage.Contains(","))
        {
            affichage += ",";
        }
    }
}
void Pourcentage()
{
    if (!double.TryParse(affichage, out double nombre))
        return;

    affichage = (nombre / 100).ToString();
    expression = affichage;
    nouveauNombre = true;
}
void AjouterExpression(string texte)
{
    if (affichage == "0" || affichage == "Erreur")
    {
        expression = "";
    }

    expression += texte;
    affichage = expression;
}
void CalculerExpression()
{
    if (string.IsNullOrWhiteSpace(expression))
        return;

    try
    {
        string exp = expression
            .Replace("×", "*")
            .Replace("÷", "/")
            .Replace(",", ".");
if (exp.Contains("^"))
{
    string[] parties = exp.Split('^');

    if (parties.Length == 2 &&
        double.TryParse(
            parties[0].Trim(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out double baseNombre) &&
        double.TryParse(
            parties[1].Trim(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out double exposant))
    {
        double resultatPuissance = Math.Pow(baseNombre, exposant);

        affichage = Math.Round(resultatPuissance, 10).ToString();
        expression = affichage;
        return;
    }
}
while (exp.Contains("sqrt("))
{
    int debut = exp.LastIndexOf("sqrt(");
    int debutNombre = debut + 5;
    int fin = exp.IndexOf(")", debutNombre);

    if (fin == -1)
    {
        affichage = "Erreur";
        return;
    }

    string texteNombre = exp.Substring(debutNombre, fin - debutNombre);

    if (!double.TryParse(
        texteNombre,
        System.Globalization.NumberStyles.Any,
        System.Globalization.CultureInfo.InvariantCulture,
        out double nombre))
    {
        affichage = "Erreur";
        return;
    }

    if (nombre < 0)
    {
        affichage = "Erreur";
        return;
    }

    double resultatRacine = Math.Sqrt(nombre);

    exp = exp.Substring(0, debut)
        + resultatRacine.ToString(System.Globalization.CultureInfo.InvariantCulture)
        + exp.Substring(fin + 1);
}
string[] fonctionsArc = { "asin(", "acos(", "atan(" };

foreach (string fonction in fonctionsArc)
{
    while (exp.Contains(fonction))
    {
        int debut = exp.LastIndexOf(fonction);
        int debutNombre = debut + fonction.Length;
        int fin = exp.IndexOf(")", debutNombre);

        if (fin == -1)
        {
            affichage = "Erreur";
            return;
        }

        string texteNombre =
            exp.Substring(debutNombre, fin - debutNombre);

        if (!double.TryParse(
            texteNombre,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out double nombreArc))
        {
            affichage = "Erreur";
            return;
        }

